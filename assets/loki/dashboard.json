{
  "title": "Neurader — Ansible Execution Monitor",
  "description": "Per-host Ansible execution visibility powered by Neurader + Loki",
  "tags": ["neurader", "ansible"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "playbook",
        "label": "Playbook",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({job=\"neurader\"}, playbook)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({job=\"neurader\", playbook=~\"$playbook\"}, host)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "status",
        "label": "Status",
        "type": "custom",
        "options": [
          { "text": "All",         "value": ".*",          "selected": true },
          { "text": "Failed",      "value": "failed",      "selected": false },
          { "text": "Success",     "value": "success",     "selected": false },
          { "text": "Unreachable", "value": "unreachable", "selected": false }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total Runs",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["count"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "{job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Failed Runs",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["count"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "{job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\", status=\"failed\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Unreachable Hosts",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["count"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "{job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\", status=\"unreachable\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Success Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": 0   },
              { "color": "yellow", "value": 80  },
              { "color": "green",  "value": 95  }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"neurader\", playbook=~\"$playbook\", status=\"success\"}[$__range])) / sum(count_over_time({job=\"neurader\", playbook=~\"$playbook\"}[$__range])) * 100",
          "legendFormat": "Success %",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Unique Hosts",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "count(count by (host) (count_over_time({job=\"neurader\", playbook=~\"$playbook\"}[$__range])))",
          "legendFormat": "Hosts",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Playbook Runs Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failed"      }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red"   } }] },
          { "matcher": { "id": "byName", "options": "success"     }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "unreachable" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange"} }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 7,
      "type": "table",
      "title": "All Playbook Runs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "sortBy": [{ "displayName": "Time", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              {
                "id": "custom.displayMode", "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "success":     { "color": "green",  "index": 0 } } },
                  { "type": "value", "options": { "failed":      { "color": "red",    "index": 1 } } },
                  { "type": "value", "options": { "unreachable": { "color": "orange", "index": 2 } } }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "Line", "format": "json" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "id": 1, "tsNs": true, "labels": true, "Line": true },
            "renameByName": {
              "Time":       "Time",
              "playbook":   "Playbook",
              "host":       "Host",
              "status":     "Status",
              "ok":         "OK",
              "changed":    "Changed",
              "failed":     "Failed",
              "unreachable":"Unreachable",
              "skipped":    "Skipped"
            },
            "indexByName": {
              "Time":       0,
              "playbook":   1,
              "host":       2,
              "status":     3,
              "ok":         4,
              "changed":    5,
              "failed":     6,
              "unreachable":7,
              "skipped":    8
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "{job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\", status=~\"$status\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 8,
      "type": "table",
      "title": "Failed & Unreachable — Error Details",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "sortBy": [{ "displayName": "Time", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } }
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "Line", "format": "json" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "id": 1, "tsNs": true, "labels": true, "Line": true, "ok": true, "changed": true, "skipped": true, "unreachable": true, "start_time": true, "end_time": true },
            "renameByName": {
              "Time":         "Time",
              "playbook":     "Playbook",
              "host":         "Host",
              "status":       "Status",
              "failed":       "Failed Tasks",
              "error_module": "Module",
              "error_msg":    "Error",
              "error_rc":     "RC",
              "error_stderr": "Stderr"
            },
            "indexByName": {
              "Time":         0,
              "playbook":     1,
              "host":         2,
              "status":       3,
              "error_module": 4,
              "error_msg":    5,
              "error_rc":     6,
              "error_stderr": 7
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "{job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\", status=~\"failed|unreachable\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },

    {
      "id": 9,
      "type": "logs",
      "title": "Raw Logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"neurader\", playbook=~\"$playbook\", host=~\"$host\", status=~\"$status\"}",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ]
    }

  ],

  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],

  "__requires": [
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" },
    { "type": "panel",      "id": "stat",        "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "timeseries",  "name": "Time series","version": "" },
    { "type": "panel",      "id": "table",       "name": "Table",      "version": "" },
    { "type": "panel",      "id": "logs",        "name": "Logs",       "version": "" }
  ]
}